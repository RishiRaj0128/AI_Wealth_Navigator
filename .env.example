# Wealth Navigator AI — environment configuration
#
# Copy this file to `backend/.env` and fill in real values. Never commit the
# filled-in file: `.gitignore` excludes `.env` and `.env.*`, and only this
# example is tracked.
#
#   cp .env.example backend/.env

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
# PostgreSQL connection string. The application creates its schema on startup
# via init_db(), so an empty database is enough to begin.
#
# The test suite NEVER uses this database directly: backend/tests/conftest.py
# rewrites the name to "<database>_test", creates it on demand, and hard-fails
# if that isolation did not take effect.
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/moneyops_v2

# -----------------------------------------------------------------------------
# AI (optional)
# -----------------------------------------------------------------------------
# Without a key the product still works end to end: financial position, goals,
# what-if scenarios and next-best actions are all computed by the backend. Only
# the conversational Wealth AI is disabled, and the UI says so plainly rather
# than faking a response.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_PROVIDER=gemini

# -----------------------------------------------------------------------------
# Inherited operations tooling (optional)
# -----------------------------------------------------------------------------
# Only needed to sync live data into the inherited MoneyOps / Incident Lab
# screens under Platform. The Wealth Navigator product does not use these, and
# the Incident Lab generator produces its synthetic dataset without them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Other providers (optional, unused by default)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
