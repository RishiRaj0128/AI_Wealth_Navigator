# Environment & Secrets (NEVER COMMIT)
.env
.env.*
backend/.env
*.env

# SQLite Databases & Local Data
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3
*.db
*.sqlite
*.sqlite3

# Local Postgres backups (may contain real/test transaction data)
backend/data/backups/

# Python
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
.npm
.vite/

# Temporary files & Scratch scripts
scratch/
.tempmediaStorage/
*.log

# IDE & OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Context
CLAUDE.md
*.md
# --- Documentation and example config are intentionally tracked -------------
# The blanket `*.md` rule above exists to keep scratch notes out of the repo,
# and `.env.*` to keep real secrets out. These specific files carry no secrets
# and are part of the deliverable, so they are re-included explicitly.
!README.md
!docs/
!docs/*.md
!.env.example
!backend/.env.example
